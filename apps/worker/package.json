{
  "name": "worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply trading-grand-prix-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply trading-grand-prix-db --remote",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@hono/zod-validator": "^0.4.2",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "shared": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "better-sqlite3": "^11.7.0",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.3",
    "wrangler": "^3.99.0"
  }
}
